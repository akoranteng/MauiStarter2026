<ContentPage 
    x:Class="MauiStarter2026.Pages.DetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Details">

    <ScrollView>
        <VerticalStackLayout
            Spacing="30"
            Padding="30"
            VerticalOptions="Center">

            <!-- Header -->
            <Label 
                Text="Details Page"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333" />

            <!-- Dynamic Message from Navigation Parameter -->
            <Label 
                x:Name="MessageLabel"
                Text="Message will appear here"
                FontSize="22"
                HorizontalOptions="Center"
                TextColor="#555" />

            <!-- Optional: Back Button -->
            <Button 
                Text="Go Back"
                FontSize="20"
                Padding="14"
                BackgroundColor="#0078D4"
                TextColor="White"
                CornerRadius="8"
                Clicked="OnBackButtonClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
