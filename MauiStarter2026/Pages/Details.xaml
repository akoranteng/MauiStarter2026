<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiStarter2026.Pages.DetailsPage"
             BackgroundColor="#F2F2F2">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- ========================= -->
            <!--       PAGE HEADER         -->
            <!-- ========================= -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Details"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A" />

                <Label Text="More information about your selected item."
                       FontSize="30"
                       TextColor="#7A7A7A" />
            </VerticalStackLayout>

            <!-- ========================= -->
            <!--         CARD UI           -->
            <!-- ========================= -->
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Item Title"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#1A1A1A" />

                    <Label Text="This is where the detailed description of the item will go. You can expand this section with more text, images, or controls."
                           FontSize="25"
                           TextColor="#4A4A4A" />


       <Button Text="Take Action"
        FontSize="28"
        BackgroundColor="#4A90E2"
        TextColor="White"
        CornerRadius="10"
        Padding="14,10"
        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
