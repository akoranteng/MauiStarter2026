<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MauiStarter2026.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        Spacing="20"
        Padding="30"
        VerticalOptions="Center">

        <Label
            Text="Welcome to MauiStarter 2026"
            FontSize="28"
            HorizontalOptions="Center" />

        <Label
            Text="This module introduces navigation with parameters."
            FontSize="18"
            HorizontalOptions="Center" />

        <Button
            Text="Go to Details Page"
            Clicked="OnNavigateButtonClicked"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
