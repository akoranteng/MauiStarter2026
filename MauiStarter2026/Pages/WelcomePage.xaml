<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiStarter2026.Pages.WelcomePage"
             BackgroundColor="{StaticResource AccentColor}">

    <Grid RowDefinitions="2*, *">

        <!-- ========================= -->
        <!--       HERO SECTION        -->
        <!-- ========================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource PrimaryColor}"
              Padding="32">

            <VerticalStackLayout VerticalOptions="Center"
                                 Spacing="12">
              

              <Label Text="Welcome"
       FontSize="50"
       FontAttributes="Bold"
       TextColor="White"
       HorizontalTextAlignment="Center" />

<Label Text="Your journey into .NET MAUI starts here."
       FontSize="30"
       TextColor="White"
       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </Grid>

        <!-- ========================= -->
        <!--     CONTENT SECTION       -->
        <!-- ========================= -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="32"
                             Spacing="24"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <Label Text="Maui Starter 2026"
                   Style="{StaticResource TitleLabel}" />

            <Label Text="A clean, modern starting point for your .NET MAUI learning modules."
                   Style="{StaticResource SubtitleLabel}" />

            <Button Text="Get Started"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnGetStartedClicked" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
