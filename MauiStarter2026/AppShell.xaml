<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MauiStarter2026.Pages"
    x:Class="MauiStarter2026.AppShell">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Shell">
                <Setter Property="Shell.NavBarHasShadow" Value="False" />
                <Setter Property="Shell.TitleColor" Value="#1A1A1A" />
                <Setter Property="Shell.ForegroundColor" Value="#1A1A1A" />
                <Setter Property="Shell.BackgroundColor" Value="#F7F7F7" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <ShellContent
        Title="Main"
        ContentTemplate="{DataTemplate pages:WelcomePage}" />

</Shell>
